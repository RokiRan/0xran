---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { useTranslations, localePath, formatDate } from '../../i18n/utils';
import { languages, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

/** Bump this date whenever the lists below change. */
const NOW_UPDATED = new Date('2026-09-04');

interface NowItem {
  date: string;
  title: string;
  body: string; // may contain inline <code>
}

interface AboutBlock {
  title: string;
  body: string;
  skills: string[];
  status: string;
}

const nowContent: Record<Lang, { about: AboutBlock; watching: NowItem[]; avoiding: NowItem[] }> = {
  zh: {
    about: {
      title: '关于我',
      body: '11 年软件开发，前端出身后转全栈，能一个人走完需求梳理、架构设计、三端开发到部署运维的闭环。交付过制造业数智管理平台（PC + 小程序 + 服务端，多租户 Docker 部署）、统一认证中心、出海结汇平台、新闻采编系统等十几个项目；带过前端小组，搭过私有 NPM / Docker 仓库与 CI/CD。这两年深度使用 AI 编程工具链，靠多 Agent 编排把单人产出放大到能独立交付整套系统。',
      skills: ['Vue3', 'TypeScript', 'NestJS', 'MySQL', 'Redis', '微信小程序', 'Electron', 'Chrome 扩展', 'Docker', 'CI/CD', '多 Agent 编排'],
      status: '目前佛系求职中：不海投、不焦虑，对 AI 应用方向的有趣机会保持开放。',
    },
    watching: [
      {
        date: '2026-08',
        title: 'AI Agent 落地',
        body: '方向定了：一心扑在 AI agent 的落地场景和应用上。0xAgent 已经开源，接下来把它摁进真实业务里用，从能跑通到真有用。',
      },
      {
        date: '2026-08',
        title: '0xAgent',
        body: '刚开源的 Agent 框架。协作层的硬闸和状态机是核心，接下来在真实场景里磨它。',
      },
      {
        date: '2026-07',
        title: 'OneShell / MyNavicat',
        body: '转入维护期，有新需求再动。',
      },
      {
        date: '2026-07',
        title: '本职工作',
        body: '在制造业做信息化。车间正好是 AI agent 落地的试验田。',
      },
    ],
    avoiding: [
      {
        date: '2026-08',
        title: '偏离方向的坑',
        body: '和 AI agent 落地无关的新坑，一律不碰。',
      },
      {
        date: '2026-07',
        title: '给这个站加功能',
        body: '已失败。友链页真香。',
      },
    ],
  },
  en: {
    about: {
      title: 'About',
      body: '11 years in software — frontend turned full-stack, closing the loop from requirements and architecture through three-end development to deployment and ops, solo. Shipped a manufacturing digital-management platform (PC + mini-program + server, multi-tenant Docker), a unified auth center, a cross-border settlement platform, newsroom systems, and a dozen more projects; led a frontend team; built private NPM/Docker registries and CI/CD. Lately I run deep on AI coding toolchains, using multi-agent orchestration to scale one person\u2019s output to delivering entire systems.',
      skills: ['Vue3', 'TypeScript', 'NestJS', 'MySQL', 'Redis', 'WeChat Mini Programs', 'Electron', 'Chrome Extensions', 'Docker', 'CI/CD', 'Multi-agent Orchestration'],
      status: 'Casually open to work right now: no mass applications, no anxiety — just interested in good applied-AI opportunities.',
    },
    watching: [
      {
        date: '2026-08',
        title: 'Applied AI agents',
        body: 'The direction is set: all-in on real-world AI agent scenarios and applications. 0xAgent is open-sourced; next step is pressing it into actual business use — from "it runs" to "it\'s useful."',
      },
      {
        date: '2026-08',
        title: '0xAgent',
        body: 'My freshly open-sourced agent framework. The coordination gates and state machines are the core; now it gets hardened in real scenarios.',
      },
      {
        date: '2026-07',
        title: 'OneShell / MyNavicat',
        body: 'Moved into maintenance mode. They change when real needs show up.',
      },
      {
        date: '2026-07',
        title: 'Day job',
        body: 'Informatization work in manufacturing — and the workshop happens to be a perfect testing ground for applied AI agents.',
      },
    ],
    avoiding: [
      {
        date: '2026-08',
        title: 'Off-direction side projects',
        body: 'Anything unrelated to applied AI agents is a hard pass.',
      },
      {
        date: '2026-07',
        title: 'Adding features to this site',
        body: 'Failed. The friend-links page is great, actually.',
      },
    ],
  },
};

const { about, watching, avoiding } = nowContent[lang];
---

<BaseLayout lang={lang} title={`${t('now.title')} · ${t('meta.siteName')}`} description={t('now.lede')} activePath="/now">
  <section class="page-hero">
    <div class="container container--content">
      <div class="fade-up">
        <a href={localePath(lang, '/')} class="back-link">
          <Icon name="arrowLeft" size={14} />
          <span>{t('nav.home')}</span>
        </a>
      </div>
      <span class="eyebrow fade-up" style="--i:1">{t('now.eyebrow', { date: formatDate(NOW_UPDATED, lang) })}</span>
      <h1 class="page-title fade-up" style="--i:2">{t('now.title')}</h1>
      <p class="hero-lede fade-up" style="--i:3; max-width: 56ch;">{t('now.lede')}</p>
      <span class="hero-rule fade-up" style="--i:4" aria-hidden="true"></span>
    </div>
  </section>

  <section class="section">
    <div class="container container--content">
      <h2 class="fade-up" style="margin-bottom: 16px;">{about.title}</h2>
      <p class="fade-up" style="--i:1; max-width: 64ch;">{about.body}</p>
      <p class="fade-up" style="--i:2; margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px 12px;">
        {about.skills.map((skill) => <code>{skill}</code>)}
      </p>
      <p class="fade-up text-muted" style="--i:3; margin-top: 16px; font-size: 0.875rem;">{about.status}</p>

      <h2 class="fade-up" style="margin-top: 48px; margin-bottom: 16px;">{t('now.watching')}</h2>
      <ul class="now-list fade-up" style="--i:1">
        {
          watching.map((item) => (
            <li class="now-item">
              <span class="date tabular">{item.date}</span>
              <div class="body">
                <strong>{item.title}</strong>
                <p set:html={item.body} />
              </div>
            </li>
          ))
        }
      </ul>

      <h2 class="fade-up" style="margin-top: 48px; margin-bottom: 16px;">{t('now.avoiding')}</h2>
      <ul class="now-list fade-up" style="--i:1">
        {
          avoiding.map((item) => (
            <li class="now-item">
              <span class="date tabular">{item.date}</span>
              <div class="body">
                <strong>{item.title}</strong>
                <p set:html={item.body} />
              </div>
            </li>
          ))
        }
      </ul>

      <hr class="divider" style="margin-top: 64px;" />
      <p class="fade-up text-muted" style="margin-top: 32px; font-size: 0.875rem; max-width: 56ch;">
        {t('now.inspiration')}
        <a href="https://nownownow.com/about" class="link" target="_blank" rel="noopener noreferrer">nownownow.com</a>{t('now.inspiration.tail')}
      </p>
    </div>
  </section>
</BaseLayout>
